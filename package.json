{
  "name": "@kitty-crow/crust",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Bake-lowered TypeScript to freestanding Rust",
  "bin": {
    "crust": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "npm run guards && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "compile": "node dist/src/cli.js",
    "guards": "bash scripts/guards.sh"
  },
  "dependencies": {
    "typescript": "~5.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@kitty-crow/code-guards": "git+https://github.com/kitty-crow/code-guards.git#b858b0e0a912b1315fde3203d1e7bcc2ff2d5427"
  }
}
